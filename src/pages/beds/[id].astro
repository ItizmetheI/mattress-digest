---
// Draft-stage detail page. noindex + sitemap-excluded (see astro.config.mjs)
// until this ships with real photography and a reviewed catalog entry — see
// TAXONOMY.md rollout gate. Schema.org Article/Product markup is
// deliberately deferred until then too: pointing structured data at a
// placeholder image and an example-stage entry would be exactly the kind of
// overclaim this codebase has already had to remediate once (see the
// EEAT_AUDIT.md history) — add it when the content is real.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allBeds } from '../../data/beds';

export function getStaticPaths() {
  return allBeds.map(bed => ({
    params: { id: bed.id },
    props: { bed },
  }));
}

const { bed } = Astro.props;
const SITE_URL = import.meta.env.SITE_URL || 'https://mattressscore.ahmedbarkat1067.workers.dev';
const scoreRows = [
  { label: 'Build Quality', value: bed.scores.buildQuality },
  { label: 'Stability & Noise', value: bed.scores.stabilityNoise },
  { label: 'Ease of Assembly', value: bed.scores.easeOfAssembly },
  { label: 'Value', value: bed.scores.value },
  { label: 'Versatility', value: bed.scores.versatility },
];
---

<BaseLayout
  title={`${bed.name} Review — The Mattress Digest`}
  description={bed.summary}
  canonicalUrl={`${SITE_URL}/beds/${bed.id}/`}
  noindex={true}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-12">
    <header class="max-w-3xl">
      <p class="text-label-sm font-label-sm uppercase tracking-normal text-secondary font-bold mb-3">{bed.bedType} bed · by {bed.brand}</p>
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold mb-4">{bed.name} Review</h1>
      <p class="text-body-lg text-on-surface-variant leading-relaxed">{bed.summary}</p>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <div class="card-editorial overflow-hidden">
          <img src={bed.heroImage} alt={bed.name} class="w-full h-72 object-contain bg-white p-6" />
        </div>
        <div class="mt-6 grid grid-cols-2 gap-4 text-body-sm">
          <div class="bg-surface-container-low rounded-lg p-4">
            <p class="text-label-sm text-on-surface-variant uppercase">Weight Capacity</p>
            <p class="text-primary font-bold text-title-md">{bed.weightCapacityLbs} lbs</p>
          </div>
          <div class="bg-surface-container-low rounded-lg p-4">
            <p class="text-label-sm text-on-surface-variant uppercase">Assembly Time</p>
            <p class="text-primary font-bold text-title-md">{bed.assemblyTimeMinutes} min</p>
          </div>
          <div class="bg-surface-container-low rounded-lg p-4">
            <p class="text-label-sm text-on-surface-variant uppercase">Frame Material</p>
            <p class="text-primary font-bold text-title-md capitalize">{bed.frameMaterial.replaceAll('-', ' ')}</p>
          </div>
          <div class="bg-surface-container-low rounded-lg p-4">
            <p class="text-label-sm text-on-surface-variant uppercase">Warranty</p>
            <p class="text-primary font-bold text-title-md">{bed.warrantyYears} yr</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-8">
        <section>
          <h2 class="text-headline-md font-headline-md text-primary font-bold mb-4">Scorecard</h2>
          <div class="flex flex-col gap-3">
            {scoreRows.map(row => (
              <div class="flex flex-col gap-1.5">
                <div class="flex justify-between items-center text-body-sm font-bold">
                  <span class="text-on-surface-variant">{row.label}</span>
                  <span class="text-primary">{row.value}/10</span>
                </div>
                <div class="w-full bg-outline-variant/20 h-2 rounded-full overflow-hidden">
                  <div class="bg-secondary h-full rounded-full" style={`width: ${row.value * 10}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="glass-panel-heavy p-6 rounded-2xl border border-secondary/20">
          <h2 class="text-headline-md font-headline-md text-primary italic mb-3">Our Verdict</h2>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">{bed.verdict}</p>
        </section>

        <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <h3 class="text-label-sm font-label-sm uppercase text-secondary font-bold mb-2">What We Liked</h3>
            <ul class="flex flex-col gap-2">
              {bed.pros.map(p => <li class="text-body-sm text-on-surface-variant">✓ {p}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="text-label-sm font-label-sm uppercase text-on-surface-variant font-bold mb-2">Points to Consider</h3>
            <ul class="flex flex-col gap-2">
              {bed.cons.map(c => <li class="text-body-sm text-on-surface-variant">✕ {c}</li>)}
            </ul>
          </div>
        </section>

        <a href={bed.productUrl} target="_blank" rel="noopener noreferrer" class="btn-gradient inline-flex items-center justify-center py-4 px-6 rounded-lg text-on-primary font-label-lg font-bold tracking-normal uppercase shadow-lg w-fit">
          View Official Product Page →
        </a>
      </div>
    </div>

    <section class="max-w-3xl">
      <h2 class="text-headline-md font-headline-md text-primary font-bold mb-6">Frequently Asked Questions</h2>
      <div class="flex flex-col divide-y divide-outline-variant">
        {bed.faqs.map(faq => (
          <div class="py-4">
            <p class="font-bold text-primary mb-1">{faq.question}</p>
            <p class="text-body-md text-on-surface-variant">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
