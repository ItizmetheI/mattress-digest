---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LINK_DISCLOSURE } from '../../lib/disclosure';
const SITE_URL = import.meta.env.SITE_URL || 'https://mattressscore.ahmedbarkat1067.workers.dev';
const CONTACT_EMAIL = import.meta.env.PUBLIC_CONTACT_EMAIL;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Privacy Policy — The Mattress Digest",
  "url": `${SITE_URL}/privacy-policy/`,
  "description": "The Mattress Digest privacy policy. How we collect, use, and protect your information.",
  "dateModified": "2026-07-14"
};
---

<BaseLayout
  title="Privacy Policy — The Mattress Digest"
  description="The Mattress Digest privacy policy. How we collect, use, and protect your information."
  canonicalUrl={`${SITE_URL}/privacy-policy/`}
  jsonLd={jsonLd}
>
  <main class="max-w-[760px] mx-auto px-margin-mobile md:px-0 py-16 relative z-10 flex flex-col gap-10">

    <header>
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold mb-4">Privacy Policy</h1>
      <p class="text-body-md text-on-surface-variant">Last updated: July 14, 2026</p>
    </header>

    <div class="flex flex-col gap-8 text-body-md text-on-surface-variant leading-relaxed">

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">1. Information We Collect</h2>
        <p>This is a mattress review and sleep-content publication — there's no account to create and no personal information required to read it. We may collect anonymized usage data (page views, referring URLs, browser type) through analytics tools purely to see how the site is performing.</p>
      </section>

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">2. External Links</h2>
        <p>You'll find links to manufacturer and retailer pages throughout the reviews. {LINK_DISCLOSURE} Once you're on a third-party site, their privacy policy governs, not ours — check theirs for specifics.</p>
      </section>

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">3. Cookies</h2>
        <p>Cookies here support analytics and basic site functionality — not personal tracking or targeted ads. Turning cookies off in your browser won't stop you from using the site.</p>
      </section>

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">4. Third-Party Services</h2>
        <p>Third-party analytics tools (Google Analytics, for instance) may collect anonymized data about your visit under their own privacy policies. We don't sell data to anyone.</p>
      </section>

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">5. Your Rights (GDPR / CCPA)</h2>
        <p>If you're in the EEA or California, you have rights to request access, correction, or deletion of personal data. Since there's no account system here, resolving that request usually just means confirming there's no account data to act on.</p>
      </section>

      <section>
        <h2 class="text-title-lg font-title-lg text-primary mb-3 font-bold">6. Contact</h2>
        {CONTACT_EMAIL ? (
          <p>For privacy-related inquiries, email <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline">{CONTACT_EMAIL}</a>.</p>
        ) : (
          <p>A dedicated privacy contact must be configured with the final production domain before launch.</p>
        )}
      </section>

    </div>
  </main>
</BaseLayout>
