---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../data/topics';
import { Layers, Snowflake, CircleDot, Activity, Waves, ShieldCheck, BadgeCheck, Moon, BookOpen } from 'lucide-react';

const lastUpdated = "2026-07-14";
const SITE_URL = import.meta.env.SITE_URL || 'https://mattressscore.ahmedbarkat1067.workers.dev';

const topicIcons: Record<string, typeof BookOpen> = {
  'memory-foam': Layers,
  'cooling-technology': Snowflake,
  'pocketed-coils': CircleDot,
  'spinal-alignment': Activity,
  'motion-isolation': Waves,
  'edge-support': ShieldCheck,
  'certipur-us': BadgeCheck,
  'sleep-cycles': Moon,
};
const getTopicIcon = (id: string) => topicIcons[id] ?? BookOpen;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Mattress & Sleep Topics — The Mattress Digest",
  "description": "The science behind sleep: memory foam, cooling technology, spinal alignment, motion isolation, sleep cycles, and more.",
  "url": `${SITE_URL}/topics/`,
  "dateModified": lastUpdated,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": topics.map((topic, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "url": `${SITE_URL}/topics/${topic.id}/`,
      "name": topic.title
    }))
  }
};
---

<BaseLayout 
  title="Key Mattress & Sleep Topics — The Mattress Digest" 
  description="Explore the science behind sleep: memory foam, cooling technology, spinal alignment, sleep cycles, and more."
  canonicalUrl={`${SITE_URL}/topics/`}
  machineReadableUrl={`${SITE_URL}/llms/topics.md`}
  lastUpdated={lastUpdated}
  ogImage="/images/mattresses/amerisleep-as3.webp"
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-16">
    <header class="flex flex-col gap-6 items-center text-center max-w-4xl mx-auto">
      <h1 class="text-headline-lg font-headline-lg  text-primary font-bold">
        Key Mattress & Sleep Topics
      </h1>
      <p class="text-body-lg font-body-lg text-on-surface-variant max-w-3xl">
        Explore the science behind sleep: memory foam, cooling technology, spinal alignment, sleep cycles, and more.
      </p>
    </header>

    <div class="grid sm:grid-cols-2 gap-6 max-w-5xl mx-auto w-full">
      {topics.map(topic => {
        const Icon = getTopicIcon(topic.id);
        return (
          <article class="card-editorial p-6 md:p-8 flex flex-col gap-5" id={topic.id}>
            <div class="gradient-brand w-14 h-14 rounded-xl flex items-center justify-center">
              <Icon class="w-7 h-7 text-white" strokeWidth={1.5} />
            </div>
            <div>
              <h2 class="text-title-lg md:text-headline-sm text-primary font-bold">
                <a href={`/topics/${topic.id}/`} class="hover:text-secondary underline-offset-4 hover:underline">{topic.title}</a>
              </h2>
              <p class="text-body-md text-on-surface-variant mt-3 leading-relaxed">{topic.description}</p>
            </div>
            <div class="mt-auto flex items-center justify-between gap-4 text-body-sm pt-4 border-t border-outline-variant/20">
              <span class="text-on-surface-variant">{topic.relatedMattresses.length} related reviews</span>
              <a href={`/topics/${topic.id}/`} class="text-secondary font-bold underline underline-offset-4 hover:text-primary">Read guide</a>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</BaseLayout>
