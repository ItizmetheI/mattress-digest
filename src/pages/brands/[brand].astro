---
import { allMattresses, warrantyValue } from '../../data/mattresses';
import { articleList, articleTable, toArticleBody } from '../../lib/schemaArticleBody';
import { RANKING_DISCLOSURE } from '../../lib/disclosure';
import BaseLayout from '../../layouts/BaseLayout.astro';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressscore.ahmedbarkat1067.workers.dev';

const BRAND_META: Record<string, { displayName: string; description: string; officialUrl: string; blurb: string }> = {
  'amerisleep': {
    displayName: 'Amerisleep',
    officialUrl: 'https://amerisleep.com',
    description: 'Every Amerisleep model we\'ve scored — 8 mattresses across the AS series, hybrid, and organic lineup.',
    blurb: 'Amerisleep sells direct-to-consumer across foam, hybrid, and latex-hybrid lines. We record Bio-Pur® foam and HIVE® zoning where applicable — confirm current materials and terms on the official product page.'
  },
  'zoma': {
    displayName: 'Zoma',
    officialUrl: 'https://zomasleep.com',
    description: 'Every Zoma model we\'ve scored — performance-built foam and hybrid mattresses including the Boost, Hybrid, and Start.',
    blurb: 'Zoma builds foam and hybrid mattresses around responsive comfort. We record Triangulex™ and Reactiv™ materials where applicable — check current construction on the official product page.'
  },
  'vaya': {
    displayName: 'Vaya',
    officialUrl: 'https://vayasleep.com',
    description: 'Every Vaya model we\'ve scored — foam and hybrid builds on the same seven-metric scorecard.',
    blurb: 'Vaya sits at the lower end of our recorded price points, with foam and hybrid models. We note CertiPUR-US labels and trial terms where they apply — confirm current scope with the official sources.'
  },
  'form': {
    displayName: 'FORM',
    officialUrl: 'https://formsleep.com',
    description: 'Every FORM model we\'ve scored — Core, Core Hybrid, Prime, and Prime X.',
