---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import FindYourMatch from '../components/FindYourMatch';
import LatestGuides from '../components/LatestGuides';
import Methodology from '../components/Methodology';
import FinalPick from '../components/FinalPick';
import { allMattresses } from '../data/mattresses';
import { comparisons } from '../data/comparisons';
import { formatDateOnly } from '../lib/dateFormat';
import { TRUST_BADGE_LABEL } from '../lib/disclosure';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressscore.ahmedbarkat1067.workers.dev';
const featuredPicks = [
  { id: 'amerisleep-as3', label: 'Best Overall', badge: '#1 Pick', desc: 'All-foam build, medium feel, and a perfect 10 Overall.' },
  { id: 'plushbeds-signature-bliss', label: 'Best Organic', badge: '10/10 Overall', desc: 'A latex hybrid carrying the widest certification list we track; confirm current scope before buying.' },
  { id: 'vaya-hybrid', label: 'Best Value', badge: '10/10 Value', desc: 'Lower-priced hybrid that still posts perfect Value and Response Time marks.' },
  { id: 'nest-bedding-sparrow', label: 'Trial Flexibility', badge: '10/10 Trial', desc: 'Hybrid construction with the longest recorded trial window in the dataset.' },
  { id: 'ghostbed-luxe', label: 'Cooling Foam', badge: '10/10 Cooling', desc: 'Foam-only build leading the field on Cooling and Motion Transfer.' },
  { id: 'westin-heavenly-bed', label: 'Hotel-Style Feel', badge: '10/10 Overall', desc: 'Pillow-top innerspring pairing solid edge support with quick response.' },
].map(config => {
  const mattress = allMattresses.find(item => item.id === config.id);
  if (!mattress) throw new Error(`Missing homepage pick: ${config.id}`);
  return { ...config, name: mattress.name, score: mattress.scores.overall, href: `/reviews/${mattress.id}/` };
});
const heroStats = [
  { value: '59', label: 'Mattress Models Scored' },
  { value: '24', label: 'Brands Covered' },
  { value: '7', label: 'Metrics Scored Per Mattress' },
  { value: '30', label: 'Head-to-Head Comparisons' },
];
const featuredComparisons = [
  'amerisleep-organica-vs-avocado-green',
  'amerisleep-as5-hybrid-vs-leesa-sapira-chill-hybrid',
  'amerisleep-as6-black-series-vs-saatva-rx',
].map(slug => {
  const comparison = comparisons.find(item => item.slug === slug);
  if (!comparison) throw new Error(`Missing homepage comparison: ${slug}`);
  const mattressA = allMattresses.find(item => item.id === comparison.mattressAId);
  const mattressB = allMattresses.find(item => item.id === comparison.mattressBId);
  if (!mattressA || !mattressB) throw new Error(`Missing homepage comparison models: ${slug}`);
  return { comparison, mattressA, mattressB };
});

const homepageFaqs = [
  {
    q: 'How are mattresses scored on this site?',
    a: 'Every model runs through the same seven-field rubric — Overall, Value, Edge Support, Trial Period, Response Time, Motion Transfer, and Cooling & Breathability — each on a 0-10 scale, with identical definitions no matter which brand is being scored.',
  },
  {
    q: 'How much of the market is actually covered here?',
    a: 'The library currently holds 59 models spanning 24 brands, backed by 30 head-to-head comparisons and 18 ranked shopping categories.',
  },
  {
    q: 'Are these scores based on lab testing or customer reviews?',
    a: 'Neither. Every score is an editorial comparison pulled from our published dataset — not a lab reading, a manufacturer\'s own rating, or an aggregation of customer reviews.',
  },
  {
    q: 'What\'s the right way to use a ranking like this?',
    a: 'Start from whichever category fits how you sleep, what you can spend, or whether you\'re sharing the bed — then work through the full scorecard, firmness, build, trial terms, and warranty before you commit.',
  },
  {
    q: 'What should I double-check before buying?',
    a: 'Confirm current price, stock, specs, certifications, shipping, trial length, and warranty directly on the brand\'s own site — we flag our recorded prices and policy fields as reference data precisely because brands change them without notice.',
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${SITE_URL}/#website`,
    "name": "The Mattress Digest",
    "url": SITE_URL,
    "description": "Scorecards, rankings, and buying guides covering 59 mattresses across 24 brands, refreshed July 2026.",
    "publisher": { "@id": `${SITE_URL}/#organization` }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL}/#organization`,
    "name": "The Mattress Digest",
    "url": SITE_URL,
    "logo": SITE_URL + "/logo.svg"
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${SITE_URL}/about/#editorial-team`,
    "name": "The Mattress Digest Editorial Team",
    "url": `${SITE_URL}/about/#editorial-team`,
    "parentOrganization": { "@id": `${SITE_URL}/#organization` }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": homepageFaqs.map(faq => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": { "@type": "Answer", "text": faq.a }
    }))
  }
];
---

<BaseLayout 
  title="59 Mattresses Scored & Ranked (2026) | The Mattress Digest"
  description="See how 59 mattresses from 24 brands stack up on our seven-metric scorecard, with full head-to-head comparisons for every matchup."
  ogTitle="59 Mattresses Scored — The Mattress Digest"
  ogImage="/images/mattresses/amerisleep-as3.webp"
  ogType="website"
  canonicalUrl={`${SITE_URL}/`}
  lastUpdated="2026-07-14"
  jsonLd={jsonLd}
>
  <div>
    <Hero client:load stats={heroStats} trustBadgeLabel={TRUST_BADGE_LABEL} />

    <!-- Main Content -->
    <main class="flex-1 w-full flex flex-col relative z-10 bg-background/50">

<!-- How It Works -->
<section class="py-16 bg-surface-container">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div class="max-w-2xl mb-12">
      <p class="text-label-sm font-label-sm uppercase text-secondary font-bold mb-3">How scoring works here</p>
      <h2 class="text-display-lg font-display-lg text-primary">Same rubric, every brand, no exceptions</h2>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-outline-variant border-t border-b border-outline-variant">
      {[
        { step: '01', title: 'A single scorecard', desc: 'Every mattress we cover gets the same seven fields — Overall, Value, Edge Support, Trial Period, Response Time, Motion Transfer, and Cooling & Breathability.' },
        { step: '02', title: 'No brand curve', desc: 'An 8 means the same thing on a $600 mattress as it does on a $4,000 one — nobody gets graded on a curve.' },
        { step: '03', title: 'Check the receipts', desc: 'Full comparison tables, ranked categories, and clearly labeled evidence limits keep our editorial calls separate from verified spec.' },
      ].map(item => (
        <div class="p-6 md:p-8 flex flex-col gap-3 bg-surface">
          <span class="font-display-lg text-headline-lg font-display-lg text-outline">{item.step}</span>
          <h3 class="text-headline-md font-headline-md text-primary mt-1">{item.title}</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Top Picks By Category -->
<section class="py-16 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
  <h2 class="text-display-lg font-display-lg text-primary mb-3">Category leaders</h2>
  <p class="text-body-lg text-on-surface-variant mb-10 max-w-2xl">Pulled from the same scorecard across every brand we track — click through for the full review behind each pick.</p>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <a href={featuredPicks[0].href} class="lg:col-span-5 card-editorial p-8 flex flex-col gap-4 group">
      <span class="text-label-sm font-label-sm uppercase tracking-normal text-secondary font-bold">{featuredPicks[0].label}</span>
      <h3 class="text-display-lg font-display-lg text-primary group-hover:text-secondary transition-colors">{featuredPicks[0].name}</h3>
      <p class="text-body-lg text-on-surface-variant leading-relaxed">{featuredPicks[0].desc}</p>
      <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant">
        <span class="text-label-sm text-on-surface-variant uppercase font-bold">{featuredPicks[0].badge}</span>
        <span class="text-secondary font-bold text-headline-md font-headline-md">{featuredPicks[0].score}/10</span>
      </div>
    </a>
    <div class="lg:col-span-7 border border-outline-variant rounded-md divide-y divide-outline-variant">
      {featuredPicks.slice(1).map((pick, index) => (
        <a href={pick.href} class="flex items-center gap-4 p-4 md:p-5 hover:bg-surface-container-low transition-colors group">
          <span class="text-label-sm text-outline font-bold w-6 shrink-0">{String(index + 2).padStart(2, '0')}</span>
          <div class="min-w-0 flex-1">
            <p class="text-label-sm text-secondary font-bold uppercase tracking-normal">{pick.label}</p>
            <h3 class="text-body-lg text-primary font-bold group-hover:text-secondary transition-colors truncate">{pick.name}</h3>
          </div>
          <span class="text-headline-md font-headline-md text-primary shrink-0">{pick.score}/10</span>
        </a>
      ))}
    </div>
  </div>
</section>

      <FindYourMatch client:visible />
      <LatestGuides />

<!-- Head-to-Head Comparisons -->
<section class="py-16 max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
    <div>
      <h2 class="text-display-lg font-display-lg text-primary mb-3">Matchups, side by side</h2>
      <p class="text-body-lg text-on-surface-variant max-w-2xl">Thirty head-to-head comparisons, each with a full chart across all seven score fields.</p>
    </div>
    <a href="/comparison/" class="shrink-0 text-secondary font-label-sm font-bold uppercase tracking-normal hover:text-primary transition-colors">
      All 30 comparisons →
    </a>
  </div>
  <div class="border border-outline-variant rounded-md divide-y divide-outline-variant">
    {featuredComparisons.map(({ comparison, mattressA, mattressB }) => {
      const total = mattressA.scores.overall + mattressB.scores.overall;
      const aShare = total > 0 ? (mattressA.scores.overall / total) * 100 : 50;
      return (
        <a href={`/comparison/${comparison.slug}/`} class="block p-5 md:p-6 hover:bg-surface-container-low transition-colors group">
          <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 mb-3">
            <div class="flex items-center gap-2 font-bold text-primary flex-1 min-w-0">
              <span class="text-title-md group-hover:text-secondary transition-colors truncate">{mattressA.name}</span>
              <span class="text-on-surface-variant font-normal text-body-md shrink-0">vs</span>
              <span class="text-title-md group-hover:text-secondary transition-colors truncate">{mattressB.name}</span>
            </div>
            <span class="text-secondary text-label-sm font-bold uppercase tracking-normal shrink-0">Compare →</span>
          </div>
          <div class="w-full h-1.5 rounded-full bg-outline-variant/30 overflow-hidden flex mb-3" aria-hidden="true">
            <div class="h-full bg-primary" style={`width: ${aShare}%`}></div>
            <div class="h-full bg-secondary flex-1"></div>
          </div>
          <p class="text-body-md text-on-surface-variant">{comparison.summary}</p>
        </a>
      );
    })}
  </div>
</section>

      <Methodology client:visible />

<!-- Homepage FAQ -->
<section class="py-16 bg-surface-container">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <h2 class="text-display-lg font-display-lg text-primary mb-3">Frequently asked questions</h2>
    <p class="text-body-lg text-on-surface-variant mb-10 max-w-2xl">Straight answers about the scorecard, what's covered, what the evidence can't tell you, and how to use the rankings.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {homepageFaqs.map(faq => (
        <div class="card-editorial p-6">
          <h3 class="font-bold text-primary text-body-lg mb-2">{faq.q}</h3>
          <p class="text-body-md text-on-surface-variant leading-relaxed">{faq.a}</p>
        </div>
      ))}
    </div>
  </div>
</section>

      <FinalPick client:visible />
    </main>
  </div>
</BaseLayout>
